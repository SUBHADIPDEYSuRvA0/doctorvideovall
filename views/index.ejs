<div class="row align-items-center">
  <div class="col-md-6">
    <h1 class="display-4">Connect with Anyone, Anywhere</h1>
    <p class="lead">
      Our video calling platform makes it easy to connect with colleagues, friends, and family from anywhere in the world.
    </p>
    <div class="mt-4">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
      <% } else { %>
        <a href="/register" class="btn btn-primary btn-lg me-2">Sign Up</a>
        <a href="/login" class="btn btn-outline-primary btn-lg">Login</a>
      <% } %>
    </div>
  </div>
  <div class="col-md-6">
    <img src="/img/hero-image.svg" alt="Video calling illustration" class="img-fluid">
  </div>
</div>

<div class="row mt-5">
  <div class="col-12 text-center">
    <h2>Features</h2>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body text-center">
        <i class="fas fa-users fa-3x text-primary mb-3"></i>
        <h3 class="card-title">Group Video Calls</h3>
        <p class="card-text">Connect with multiple participants in high-quality video conferences.</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body text-center">
        <i class="fas fa-desktop fa-3x text-primary mb-3"></i>
        <h3 class="card-title">Screen Sharing</h3>
        <p class="card-text">Share your screen with participants for presentations and collaboration.</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body text-center">
        <i class="fas fa-comments fa-3x text-primary mb-3"></i>
        <h3 class="card-title">Chat & Reactions</h3>
        <p class="card-text">Send messages and reactions during calls to enhance communication.</p>
      </div>
    </div>
  </div>
</div>

<div class="row mt-5">
  <div class="col-12 text-center">
    <h2>How It Works</h2>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-4">
    <div class="text-center">
      <div class="step-circle">1</div>
      <h4 class="mt-3">Create an Account</h4>
      <p>Sign up for free and set up your profile.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="text-center">
      <div class="step-circle">2</div>
      <h4 class="mt-3">Start or Join a Meeting</h4>
      <p>Create a new meeting or join with a meeting ID.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="text-center">
      <div class="step-circle">3</div>
      <h4 class="mt-3">Connect & Collaborate</h4>
      <p>Enjoy high-quality video calls with all the features you need.</p>
    </div>
  </div>
</div>
