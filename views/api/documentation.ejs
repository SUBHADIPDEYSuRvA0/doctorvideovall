<div class="row">
  <div class="col-md-12">
    <h1>API Documentation</h1>
    <p>This documentation provides information about the Video Calling API endpoints and how to use them.</p>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-3">
    <div class="list-group" id="api-nav">
      <a class="list-group-item list-group-item-action active" href="#authentication">Authentication</a>
      <a class="list-group-item list-group-item-action" href="#meetings">Meetings</a>
      <a class="list-group-item list-group-item-action" href="#examples">Code Examples</a>
    </div>
  </div>
  <div class="col-md-9">
    <div class="card">
      <div class="card-body">
        <section id="authentication">
          <h2>Authentication</h2>
          <p>All API requests require an API key to be included in the request headers.</p>
          
          <div class="alert alert-info">
            <strong>API Key Header:</strong> <code>x-api-key</code>
          </div>
          
          <h3>Getting an API Key</h3>
          <p>API keys can be generated by an administrator. Contact your administrator to get an API key.</p>
        </section>
        
        <hr>
        
        <section id="meetings" class="mt-4">
          <h2>Meetings</h2>
          
          <div class="card mb-4">
            <div class="card-header">
              <h3 class="mb-0">Create Meeting</h3>
            </div>
            <div class="card-body">
              <p><strong>Endpoint:</strong> <code>POST /api/meetings</code></p>
              <p><strong>Description:</strong> Creates a new meeting.</p>
              
              <h4>Request Body</h4>
              <pre><code>{
  "title": "Meeting Title",
  "description": "Meeting Description"
}</code></pre>
              
              <h4>Response</h4>
              <pre><code>{
  "success": true,
  "meeting": {
    "id": "meeting-id",
    "title": "Meeting Title",
    "description": "Meeting Description",
    "host": {
      "id": "user-id",
      "name": "User Name",
      "email": "user@example.com"
    },
    "joinUrl": "https://example.com/meetings/meeting-id"
  }
}</code></pre>
            </div>
          </div>
          
          <div class="card mb-4">
            <div class="card-header">
              <h3 class="mb-0">Get Meetings</h3>
            </div>
            <div class="card-body">
              <p><strong>Endpoint:</strong> <code>GET /api/meetings</code></p>
              <p><strong>Description:</strong> Gets all meetings for the authenticated user.</p>
              
              <h4>Response</h4>
              <pre><code>{
  "success": true,
  "meetings": [
    {
      "id": "meeting-id",
      "title": "Meeting Title",
      "description": "Meeting Description",
      "host": {
        "id": "user-id",
        "name": "User Name",
        "email": "user@example.com"
      },
      "startTime": "2023-01-01T00:00:00.000Z",
      "endTime": "2023-01-01T01:00:00.000Z",
      "isActive": true,
      "participantCount": 5,
      "joinUrl": "https://example.com/meetings/meeting-id"
    }
  ]
}</code></pre>
            </div>
          </div>
          
          <div class="card mb-4">
            <div class="card-header">
              <h3 class="mb-0">Get Meeting Details</h3>
            </div>
            <div class="card-body">
              <p><strong>Endpoint:</strong> <code>GET /api/meetings/:id</code></p>
              <p><strong>Description:</strong> Gets details for a specific meeting.</p>
              
              <h4>Response</h4>
              <pre><code>{
  "success": true,
  "meeting": {
    "id": "meeting-id",
    "title": "Meeting Title",
    "description": "Meeting Description",
    "host": {
      "id": "user-id",
      "name": "User Name",
      "email": "user@example.com"
    },
    "startTime": "2023-01-01T00:00:00.000Z",
    "endTime": "2023-01-01T01:00:00.000Z",
    "isActive": true,
    "participants": [
      {
        "id": "user-id",
        "name": "User Name",
        "email": "user@example.com",
        "joinedAt": "2023-01-01T00:00:00.000Z",
        "leftAt": "2023-01-01T01:00:00.000Z"
      }
    ],
    "joinUrl": "https://example.com/meetings/meeting-id"
  }
}</code></pre>
            </div>
          </div>
          
          <div class="card mb-4">
            <div class="card-header">
              <h3 class="mb-0">End Meeting</h3>
            </div>
            <div class="card-body">
              <p><strong>Endpoint:</strong> <code>POST /api/meetings/:id/end</code></p>
              <p><strong>Description:</strong> Ends a specific meeting.</p>
              
              <h4>Response</h4>
              <pre><code>{
  "success": true,
  "message": "Meeting ended successfully"
}</code></pre>
            </div>
          </div>
        </section>
        
        <hr>
        
        <section id="examples" class="mt-4">
          <h2>Code Examples</h2>
          
          <div class="card mb-4">
            <div class="card-header">
              <h3 class="mb-0">JavaScript</h3>
            </div>
            <div class="card-body">
              <pre><code>// Create a meeting
async function createMeeting() {
  const response = await fetch('https://example.com/api/meetings', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': 'your-api-key'
    },
    body: JSON.stringify({
      title: 'Team Meeting',
      description: 'Weekly team sync'
    })
  });
  
  const data = await response.json();
  console.log(data);
}</code></pre>
            </div>
          </div>
          
          <div class="card mb-4">
            <div class="card-header">
              <h3 class="mb-0">Python</h3>
            </div>
            <div class="card-body">
              <pre><code>import requests

# Create a meeting
def create_meeting():
    url = "https://example.com/api/meetings"
    headers = {
        "Content-Type": "application/json",
        "x-api-key": "your-api-key"
    }
    payload = {
        "title": "Team Meeting",
        "description": "Weekly team sync"
    }
    
    response = requests.post(url, json=payload, headers=headers)
    data = response.json()
    print(data)</code></pre>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

<script>
  // Smooth scrolling for API navigation
  document.querySelectorAll('#api-nav a').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      
      document.querySelectorAll('#api-nav a').forEach(a => {
        a.classList.remove('active');
      });
      
      this.classList.add('active');
      
      const targetId = this.getAttribute('href');
      const targetElement = document.querySelector(targetId);
      
      window.scrollTo({
        top: targetElement.offsetTop - 20,
        behavior: 'smooth'
      });
    });
  });
</script>
